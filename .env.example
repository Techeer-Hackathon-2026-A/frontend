# GitHub OAuth App (github.com/settings/developers → New OAuth App)
# Authorization callback URL: <APP_URL>/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 세션 쿠키 암호화 키, 32자 이상 (openssl rand -base64 32)
SESSION_SECRET=

# 배포 주소. 비우면 요청 주소를 쓴다 (로컬은 비워도 됨)
APP_URL=

# 팀 백엔드(FastAPI) 주소. 비우면 http://localhost:8000. /api/v1 은 이 주소로 전달된다
BACKEND_URL=
# 백엔드가 요구하면 Authorization: Bearer 로 붙는다
BACKEND_API_KEY=

# (테스트용) GitHub API 대신 쓸 주소. 비우면 https://api.github.com
GITHUB_API_URL=
